# ═══════════════════════════════════════════════════════════════════
#  Swiggy Hunter v2 — secrets
# ═══════════════════════════════════════════════════════════════════

# ---- LLM gateway ----
GLM_API_KEY=your_top_tools_ai_key_here
GLM_BASE_URL=https://top-tools-ai.com/v1

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- Swiggy (optional — can be set via telegram) ----
SWIGGY_PHONE=
SWIGGY_COOKIE=

# ---- Vault encryption key (Fernet base64) ----
# leave blank to auto-generate on first boot
SWIGGY_SESSION_VAULT_KEY=
