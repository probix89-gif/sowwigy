{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pip install playwright && playwright install --with-deps chromium"
  },
  "deploy": {
    "startCommand": "python -m swiggy_hunter run",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
